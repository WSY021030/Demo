; SameSite=Lax";\n\n    //document.cookie = "AMCV_8E929CC25A1FB2B30A495C97%40AdobeOrg=1%7CMCMID%7C" + ecid + "%7C" + attrs;\n    document.cookie = "Adobe_ECID=" + ecid + attrs;\n  }\n});',language:"javascript"},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!0,source:'/*\n  Logic:\n    Initial, first time visit -\n      current_delay doesn\'t exist - previous_delay set to "Not Set"\n      page loads - current_delay is set to:\n        1. Data Layer exists - "On Load"\n        2. Data Layer does not exist but path is in active list - "On Active Paths"\n        3. Data Layer does not exist and path is not in active list - "##" seconds either of when DataLayer was created or time out of 10sec\n      Data Layer event is present for scenarios 1 & 2 - preloaders rule executes - v67 is pushed as "Not Set"\n    OR\n      Data Layer is not present, preloaders does not execute.\n    Next page loads -\n      current_delay exists as set by previous page\n      page loads - current_delay is set to:\n        1. Data Layer exists - "On Load"\n        2. Data Layer does not exist but path is in active list - "On Active Paths"\n        3. Data Layer does not exist and path is not in active list - "##" seconds either of when DataLayer was created or time out of 10sec\n      Data Layer event is present for scenarios 1 & 2 - preloaders rule executes - v67 is pushed as value set by scenario\n    OR\n      Data Layer is not present, preloaders does not execute.*\n\n*/\n\n//    console.log("\u300c\u039bu\u039e\u03a4\u300d: data layer check");\nlocalStorage.setItem("analytics_previous_delay", localStorage.getItem("analytics_current_delay") || "Not Set");\nlocalStorage.setItem("analytics_previous_url", localStorage.getItem("analytics_current_url") || "Not Set");\nlocalStorage.setItem("analytics_current_url",location.href);\n\n//    eVar 67 - to capture the interval delay before getting stopped - on previous page\n\nwindow.adobeDataLayer = window.adobeDataLayer || [];\n\nif ( adobeDataLayer.length == 0 ){\n  var active_paths = {\n        "_search_advanced":{\n          sheet_name: "Advanced Search",\n          sheet_type: "Search"\n        },\n        "_search_ai":{\n          sheet_name: "Xplore AI Home",\n          sheet_type: "Search"                \n        },\n        "_xpl_accessinfo":{\n          sheet_name: "What Can I Access",\n          sheet_type: "Settings"          \n        }\n      },\n      path = location.pathname.replace(/\\//g,"_"),\n      payload = JSON.parse(localStorage.getItem("analytics_pageload")) || {event:"view",data:{user_type:"not_loaded"}};\n\n  if ( active_paths[path] ){\n      payload.data.sheet_name = active_paths[path].sheet_name;\n      payload.data.sheet_type = active_paths[path].sheet_type;\n      payload.extension_identifier = "Global:: Top Loaders";\n    \n    if (payload.data.sheet_name == "Xplore AI Home" ) {\n      console.log(\'\u300c\u039bu\u039e\u03a4\u300d: data layer check: payload.data.sheet_name == "Xplore AI Home"\');\n      var waitfordevpush = setTimeout(function(){\n        \n        var last_push = window.adobeDataLayer.reverse()[0],\n            last_sheet = last_push && (last_push.data ? last_push.data.sheet_name:last_push.page.name ) || "";\n        \n      console.log(\'\u300c\u039bu\u039e\u03a4\u300d: data layer check: inTimeout: last_sheet = \' + last_sheet);\n\n        if ( last_sheet != "Research Navigator AI Search" && !(/search\\/ai\\?searchType=/).test(document.location.href) ) {\n          payload = JSON.parse(localStorage.getItem("analytics_pageload"));\n          payload.data.sheet_name = "Research Navigator AI Search";\n          payload.data.sheet_type = "Search";\n          payload.extension_identifier = "Global:: Top Loaders: patch";\n          payload.debug = {page_name:"Set from active_paths logic"}\n          adobeDataLayer.push(payload);\n      console.log(\'\u300c\u039bu\u039e\u03a4\u300d: data layer check: inTimeout: push payload\');\n        }\n        clearTimeout(waitfordevpush);\n      },3000);\n      \n    } else {\n      adobeDataLayer.push(payload);\n    }\n    \n      localStorage.setItem("analytics_current_delay", "On Active Paths");\n\n  } else {\n    let count = 0,\n        delay = 500;\n\n    const intervalId = setInterval(() => {\n      count++;\n//      console.log(`\u300c\u039bu\u039e\u03a4\u300d: data layer check: Interval Count: ${count}`);\n      if (adobeDataLayer.length > 0 || count === 20) {\n        localStorage.setItem("analytics_current_delay", (count * delay)/1000 );\n        clearInterval(intervalId);\n//        console.log("\u300c\u039bu\u039e\u03a4\u300d: data layer check: Interval Stopped: " + count);\n      }\n    }, delay);\n  }\n} else {\n//      console.log("\u300c\u039bu\u039e\u03a4\u300d: data layer check: Loaded on 1st attempt");\n  localStorage.setItem("analytics_current_delay", "On Load");\n}',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL042c0183ddab422493f699fa98c65001",name:"674::Dynamic HTML Course View Purchase Options",events:[{modulePath:"core/src/lib/events/mousedown.js",settings:{elementSelector:'[data-analytics_identifier="browse_courses_coursePg_signin_button"]',bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/e5c8ba88cef8/7fd951921a72/40912708c982/RCc0f54b7ea3ee4bfb80802bbc3c17f74d-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{_experience:{analytics:{event1to100:{event78:{value:1}},customDimensions:{eVars:{eVar9:"%[v009]Usage%"}}}}},dataElementId:"DEc94be73fae0d4897b297784e19a4ce87"},timeout:2e3,delayNext:!0},{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM:: Merged Link Click%",type:"web.webinteraction.linkClicks",instanceName:"alloy"},timeout:2e3,delayN